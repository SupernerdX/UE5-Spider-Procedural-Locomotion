# -------------------------------
# Visual Studio / Rider / IDE
# -------------------------------

# Visual Studio
.vs/
*.VC.db
*.VC.opendb

# Rider
.idea/
*.sln.iml

# VSCode
.vscode/

# -------------------------------
# Compiled Object / Binary Files
# -------------------------------

*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Dynamic Libraries
*.so
*.dylib
*.dll

# Static Libraries
*.lai
*.la
*.a


# Executables
*.exe
*.out
*.app
*.ipa

# -------------------------------
# Unreal Engine Build Artifacts
# -------------------------------

# Compiled & generated by UE
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/
*.lscache

# Plugin binaries / intermediates
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Map built data
*_BuiltData.uasset

# -------------------------------
# Engine / Project Generated Files
# -------------------------------

# Generated project files
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf

# Build cache
SourceArt/**/*.png
SourceArt/**/*.tga

# Allow Pak blacklists
!Build/*/PakBlacklist*.txt

# Don’t ignore icons in Build
!Build/**/*.ico

# -------------------------------
# Logs
# -------------------------------
Saved/Logs/

# -------------------------------
# User/local settings
# -------------------------------
*.user
*.userprefs
*.uproject.bak
/OnTheNose_PT/Saved

# Allow Steamworks DLLs
!Binaries/ThirdParty/Steamworks/**
